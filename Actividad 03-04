public class Main {

    public static void main(String[] args) {

        ColaReportes cola = new ColaReportes();

        cola.agregarReporte("Biblioteca llena");
        cola.agregarReporte("Laboratorio libre");
        cola.agregarReporte("Cafetería media");

        cola.procesarReporte();
        cola.procesarReporte();
        cola.procesarReporte();

    }

}

import java.util.LinkedList;
import java.util.Queue;

public class ColaReportes {

    private Queue<String> cola = new LinkedList<>();

    public void agregarReporte(String reporte) {
        cola.offer(reporte);
    }

    public void procesarReporte() {

        if (!cola.isEmpty()) {
            System.out.println("Procesando: " + cola.poll());
        } else {
            System.out.println("No hay reportes.");
        }

    }

}
