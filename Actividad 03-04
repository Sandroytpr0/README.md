public class Reporte {

    private String lugar;
    private String aforo;

    public Reporte(String lugar, String aforo) {
        this.lugar = lugar;
        this.aforo = aforo;
    }

    public String getLugar() {
        return lugar;
    }

    public String getAforo() {
        return aforo;
    }

    @Override
    public String toString() {
        return lugar + " - " + aforo;
    }

}

public class Nodo {

    Reporte reporte;
    Nodo siguiente;

    public Nodo(Reporte reporte) {
        this.reporte = reporte;
    }

}

public class ListaReportes {

    private Nodo inicio;

    // Insertar
    public void insertar(Reporte reporte) {

        Nodo nuevo = new Nodo(reporte);

        if (inicio == null) {
            inicio = nuevo;
            return;
        }

        Nodo aux = inicio;

        while (aux.siguiente != null) {
            aux = aux.siguiente;
        }

        aux.siguiente = nuevo;
    }

    // Buscar
    public Reporte buscar(String lugar) {

        Nodo aux = inicio;

        while (aux != null) {

            if (aux.reporte.getLugar().equalsIgnoreCase(lugar))
                return aux.reporte;

            aux = aux.siguiente;
        }

        return null;
    }

    // Eliminar
    public void eliminar(String lugar) {

        if (inicio == null)
            return;

        if (inicio.reporte.getLugar().equalsIgnoreCase(lugar)) {
            inicio = inicio.siguiente;
            return;
        }

        Nodo actual = inicio;

        while (actual.siguiente != null) {

            if (actual.siguiente.reporte.getLugar().equalsIgnoreCase(lugar)) {
                actual.siguiente = actual.siguiente.siguiente;
                return;
            }

            actual = actual.siguiente;
        }
    }

    // Recorrer
    public void mostrar() {

        Nodo aux = inicio;

        while (aux != null) {
            System.out.println(aux.reporte);
            aux = aux.siguiente;
        }

    }

}


