import java.util.Stack;

public class HistorialRutas {

    private Stack<String> historial = new Stack<>();

    public void guardarRuta(String ruta) {
        historial.push(ruta);
    }

    public void volver() {

        if (!historial.isEmpty()) {
            System.out.println("Regresando desde: " + historial.pop());
        } else {
            System.out.println("No hay historial.");
        }

    }

}

